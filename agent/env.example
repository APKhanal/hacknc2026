# Photon/Spectrum cloud credentials, from the Photon dashboard.
PROJECT_ID=
PROJECT_SECRET=

# Dev B's FastAPI orchestrator.
API_BASE_URL=http://localhost:8000

# Dev D's Next.js replay app, used to build the replay link when /ask
# returns a relative replay_url (vs. an absolute one — confirm with B).
REPLAY_BASE_URL=http://localhost:3000

# Phone number -> Nessie customer_id. Hardcoded map is the correct answer
# for a hackathon; do not build auth.
CUSTOMER_PHONE_MAP={"+15551234567":"customer_id_here"}

# How long we wait for POST /ask before giving up and sending a fallback
# message instead of going silent.
ASK_TIMEOUT_MS=20000

# Optional: send a one-off interim message if /ask is still pending after
# this many ms (on top of the typing indicator). Leave INTERIM_MESSAGE_TEXT
# empty to disable. Decide the real value with Dev B at the Round 2
# handshake, once you've seen real /ask latency.
INTERIM_MESSAGE_AFTER_MS=8000
INTERIM_MESSAGE_TEXT=

# Optional: a thumbs-up reaction on a result re-runs /ask with the decision
# applied. Cut-able feature — off by default.
ENABLE_REACTION_RERUN=false
